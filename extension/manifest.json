{
  "manifest_version": 3,
  "name": "CornMute – Auto-Mute for NSFW Sites",
  "short_name": "CornMute",
  "version": "1.0.0",
  "description": "Automatically mutes the tab the moment an adult / NSFW site starts loading, before any sound plays.",
  "permissions": ["webNavigation", "storage", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CornMute",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "options_ui": { "page": "sites.html", "open_in_tab": true },
  "commands": {
    "toggle-mute-tab": {
      "suggested_key": { "default": "Alt+Shift+M", "mac": "Alt+Shift+M" },
      "description": "Mute / unmute the current tab"
    }
  },
  "incognito": "spanning",
  "minimum_chrome_version": "116"
}
